# api/.env.example — untuk pengembangan LOKAL (di luar Docker)
# Salin: cp api/.env.example api/.env
# Di deployment (Docker) file ini tidak dipakai: env disuntik oleh deployment/docker-compose.yml.

# PostgreSQL (kalau menjalankan `docker compose -f deployment/docker-compose.yml up -d db`
# dengan POSTGRES_PORT=15432, atau database lokal sendiri)
DATABASE_URL=postgresql://postgres:ubah-password-ini-jadi-panjang-dan-acak@127.0.0.1:15432/portfolio

# Port API lokal (web/next.config.js meneruskan /api ke 3210)
PORT=3210

# Zona waktu toko untuk perhitungan "hari ini" pada nomor antrian
SHOP_TIMEZONE=Asia/Jakarta

# Prisma 7 membutuhkan file konfigurasi CLI ini ada: prisma7.config.ts (sudah ada di repo)
