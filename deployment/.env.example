# deployment/.env.example
# Salin:  cp deployment/.env.example deployment/.env
# File .env JANGAN di-commit (sudah masuk deployment/.gitignore).
# Semua nilai di sini di-interpolasi oleh docker compose (lihat docker-compose.yml).

# ── Identitas project & domain ────────────────────────────────
COMPOSE_PROJECT_NAME=portfolio
# Domain publik tanpa protokol. Untuk coba-coba lokal: localhost
DOMAIN=example.com
# Email untuk notifikasi Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.com
# 1 = pakai staging Let's Encrypt (sertifikat tidak dipercaya browser, tapi
# tidak kena rate limit) — pakai ini untuk uji coba dulu, lalu ubah ke 0.
LETSENCRYPT_STAGING=1
TZ=Asia/Jakarta

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_VERSION=17
POSTGRES_USER=postgres
# WAJIB diganti. Kalau mengandung karakter spesial (@ : / #), URL-encode dulu
# karena dipakai juga di DATABASE_URL.
POSTGRES_PASSWORD=ubah-password-ini-jadi-panjang-dan-acak
POSTGRES_DB=portfolio
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_LOG_MIN_DURATION_MS=1000

# ── Backend (NestJS) ──────────────────────────────────────────
NODE_VERSION=24
# Migrasi TIDAK lagi dijalankan oleh proses API (image runtime tidak membawa Prisma
# CLI). Migrasi dijalankan otomatis oleh service "api-migrate" sebelum api start,
# dan bisa dipicu manual dengan: make migrate
RUN_MIGRATIONS=false
LOG_LEVEL=info
# Zona waktu toko: dipakai untuk menentukan "hari ini" pada nomor antrian
SHOP_TIMEZONE=Asia/Jakarta
# Origin yang diizinkan CORS (dipisah koma kalau lebih dari satu)
CORS_ORIGIN=https://example.com
API_IMAGE=portfolio-api:local
API_MIGRATE_IMAGE=portfolio-api:migrator

# ── Frontend (Next.js) ────────────────────────────────────────
# Ditanam saat build (NEXT_PUBLIC_*). Semua trafik lewat domain yang sama,
# jadi relatif "/api" paling aman.
NEXT_PUBLIC_API_URL=/api
WEB_IMAGE=portfolio-web:local
# Akses langsung ke frontend tanpa Nginx/TLS: http://localhost:3000
# (hanya 127.0.0.1 — tidak terbuka ke internet). Ubah/ganti kalau 3000 sudah dipakai.
WEB_PORT=3000

# ── Nginx / TLS ───────────────────────────────────────────────
NGINX_VERSION=stable
NGINX_IMAGE=portfolio-nginx:local
CERTBOT_VERSION=v5.8.0
HTTP_PORT=80
HTTPS_PORT=443
NGINX_CLIENT_MAX_BODY_SIZE=25m

# ── Backup ────────────────────────────────────────────────────
# Path relatif terhadap folder deployment/
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# ── Limit resource (dipakai docker-compose.prod.yml) ──────────
DB_CPU_LIMIT=1.0
DB_MEM_LIMIT=1g
DB_MEM_RESERVATION=512m
API_CPU_LIMIT=1.5
API_MEM_LIMIT=1g
API_MEM_RESERVATION=256m
WEB_CPU_LIMIT=1.0
WEB_MEM_LIMIT=768m
WEB_MEM_RESERVATION=256m
NGINX_CPU_LIMIT=1.0
NGINX_MEM_LIMIT=256m
