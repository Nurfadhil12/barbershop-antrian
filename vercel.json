{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "INTERNAL_API_URL"
        }
      ]
    },
    "api": {
      "root": "api/"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
